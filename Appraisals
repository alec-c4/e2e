appraise "rails-7.0" do
  gem "rails", "~> 7.0.0"
  # ActiveRecord 7.0's sqlite3 adapter hard-pins `gem "sqlite3", "~> 1.4"` at
  # runtime; the sqlite3 2.x line (required by Rails 8.0+) fails to activate.
  gem "sqlite3", "~> 1.4"
end

appraise "rails-7.1" do
  gem "rails", "~> 7.1.0"
end

